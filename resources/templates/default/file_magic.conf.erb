    <%if rule['action'] == 'drop' or rule['action'] == 'filter'%>
<%= "file type:#{rule['type']}; id:#{rule['id']}; category:#{rule['category']}; msg:'#{rule['msg']}'; rev:#{rule['rev']}; content:| #{rule['content']} |; offset:#{rule['offset']};".strip %>
    <% end %>
  <%end%>
<% end %>